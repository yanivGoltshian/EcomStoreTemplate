# ──────────────────────────────────────────────────────────────────────────
#  EcomStoreTemplate — environment variables
# ──────────────────────────────────────────────────────────────────────────
# Copy this file to `.env` for local development:  cp .env.example .env
#
# IMPORTANT
#  • The PUBLIC storefront is a static export and reads NONE of these at build
#    time — all storefront config lives in src/data/site.json (edit that, or
#    run `npm run setup`).
#  • These variables configure the ADMIN write API (api/, Azure Functions) and
#    the local admin harness (tools/admin-local.mjs).
#  • In PRODUCTION you do NOT use this file. Set these as application settings
#    on your function host (Azure Static Web Apps → Configuration). See
#    api/local.settings.json.example for the Azure-local equivalent.
#  • NEVER commit real secrets. `.env*` and `api/local.settings.json` are
#    already git-ignored.
# ──────────────────────────────────────────────────────────────────────────

# ── Admin authentication ───────────────────────────────────────────────────
# Google OAuth Web Client ID (…apps.googleusercontent.com). The SERVER verifies
# the signed-in user's Google token against this. The CLIENT reads its own copy
# from public/admin-auth.json (written by `npm run setup`) — keep both in sync.
GOOGLE_CLIENT_ID=

# Comma-separated allowlist of Google account emails permitted into the admin.
# Only these verified emails can read/write content. e.g. a@gmail.com,b@gmail.com
ADMIN_EMAILS=

# ── Content repository (where the admin commits JSON + images) ──────────────
# Fine-grained GitHub PAT with "Contents: Read and write" on the repo below.
# Each admin save commits to this repo, which triggers a rebuild/redeploy.
GITHUB_TOKEN=

# owner/repo that holds the live store content (usually this same repo once
# you've created your store from the template).
GITHUB_REPO=your-github-username/your-store-repo

# Branch the admin commits to (the branch your deploy builds from).
GITHUB_BRANCH=main

# ── Newsletter signup (Brevo) — OPTIONAL, ships OFF by default ──────────────
# The newsletter feature is disabled until you turn it on (admin → ניוזלטר tab,
# or `npm run newsletter:setup`). These only matter once you enable it.
#
# Brevo (free SaaS, 300 emails/day) handles the contact list + sending + the
# legal unsubscribe link. Get an API key at https://app.brevo.com/settings/keys/api
# In production set BREVO_API_KEY as a SECRET app setting on your function host.
BREVO_API_KEY=

# Numeric Brevo contact list ID new subscribers are added to. You can instead
# set the list ID in the admin (it's saved in src/data/newsletter-settings.json).
BREVO_LIST_ID=

# Extra public origins allowed to POST to the subscribe Function (CORS).
# Only needed for a SPLIT-HOST setup, where the public storefront is served from
# a DIFFERENT origin than the function host (e.g. Vercel public + Azure SWA API).
# Comma-separated, no trailing slash. localhost:3000/:8787 are always allowed.
#   e.g. https://www.example.com,https://example.vercel.app
ALLOWED_ORIGINS=

# SPLIT-HOST only: absolute origin of the function host, baked into the client
# so the newsletter form (served from the public origin) POSTs cross-origin to
# the API. Leave EMPTY for a single-host setup (form posts to same-origin /api).
#   e.g. https://your-app.azurestaticapps.net
NEXT_PUBLIC_API_BASE=

# ── Local development only (tools/admin-local.mjs offline admin harness) ────
# Set to 1 to BYPASS Google sign-in locally so you can use the admin offline.
# MUST be unset/0 in production.
ADMIN_DEV=1

# Filesystem root the local harness reads/writes content against.
# Defaults to the repository root if unset.
REPO_ROOT=.

# Port the local admin harness listens on (default 8787).
ADMIN_PORT=8787

# Origin of the running `next dev` server the harness proxies the storefront to.
NEXT_ORIGIN=http://localhost:3000

# Optional: force the harness to proxy all non-API requests to NEXT_ORIGIN
# instead of serving the static `out/` build. Leave empty unless debugging.
ADMIN_FORCE_PROXY=
